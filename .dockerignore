# Keep the Docker build context small and avoid copying host-only / secret files.
.git
.gitignore
.claude
.env
.env.*
!.env.example

# Node
frontend/node_modules
**/node_modules
frontend/dist

# Python
**/__pycache__
*.pyc
.venv
venv

# TLS material (created on the server)
letsencrypt
certbot-webroot

# Docs aren't needed inside the images
docs

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode
