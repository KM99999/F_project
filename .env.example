# Copy this file to .env and fill in real values. NEVER commit .env (it is gitignored).

# --- Database ---
# These are the single source of truth. The db container uses them, and the API
# builds its connection URL from them automatically (host defaults to "db").
# For docker-compose you only need to set POSTGRES_PASSWORD to a strong value.
POSTGRES_USER=recibos
POSTGRES_PASSWORD=recibos
POSTGRES_DB=recibos

# Optional: only set DATABASE_URL to OVERRIDE the assembled URL — e.g. for a
# local (non-docker) run against localhost, or SQLite:
#   DATABASE_URL=postgresql+psycopg2://recibos:recibos@localhost:5432/recibos
#   DATABASE_URL=sqlite:///./dev.db
# Leave it unset/commented for the normal docker-compose deploy.
# DATABASE_URL=

# --- Auth / JWT ---
# Generate a strong random value in production, e.g.:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS (only relevant when the SPA runs on a different origin, e.g. vite dev) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Seed user (first login for the demo) ---
# Login is by username (not email). The password below is WEAK — change it to a
# strong value before handling real data (§6.2).
SEED_USER_USERNAME=administrator
SEED_USER_PASSWORD=123456789
SEED_USER_ROLE=admin

# --- App ---
ENVIRONMENT=development
