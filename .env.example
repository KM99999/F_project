# Copy this file to .env and fill in real values. NEVER commit .env (it is gitignored).

# --- Database ---
POSTGRES_USER=recibos
POSTGRES_PASSWORD=recibos
POSTGRES_DB=recibos
# Used by the API. Inside docker-compose the host is "db"; for local (non-docker)
# runs use localhost.
DATABASE_URL=postgresql+psycopg2://recibos:recibos@db:5432/recibos

# --- Auth / JWT ---
# Generate a strong random value in production, e.g.:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS (only relevant when the SPA runs on a different origin, e.g. vite dev) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Seed user (first login for the demo) ---
SEED_USER_EMAIL=admin@recibos.local
SEED_USER_PASSWORD=cambiar-esta-clave
SEED_USER_ROLE=admin

# --- App ---
ENVIRONMENT=development
